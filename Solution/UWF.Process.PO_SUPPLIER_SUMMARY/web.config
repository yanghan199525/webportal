<?xml version="1.0"?>
<configuration>
  <!--
    有关 web.config 更改的说明，请参见 http://go.microsoft.com/fwlink/?LinkId=235367。

    可在 <httpRuntime> 标记上设置以下特性。
      <system.Web>
        <httpRuntime targetFramework="4.8" />
      </system.Web>
  -->
  <system.web>
    <compilation debug="true" targetFramework="4.8.1"/>
    <pages controlRenderingCompatibilityVersion="4.0"/>
  </system.web>
  <appSettings>
    <add key="BPM_WEB_API_URL" value="https://testingautosmartwebapi.sodexo-cn.com"/>
    <add key="BPM_WEB_URL" value="https://testingautosmart.sodexo-cn.com"/>
  </appSettings>
</configuration>